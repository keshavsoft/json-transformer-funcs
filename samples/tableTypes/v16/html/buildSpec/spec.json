{
    "buildBodyTr": {
        "tagName": "tr",
        "attributes": {
            "class": "align-middle"
        },
        "children": []
    },
    "buildColGroup": {
        "tagName": "col",
        "attributes": {
            "width": "${width}"
        }
    },
    "buildHeader": {
        "tagName": "th",
        "textContent": "${columnName}",
        "attributes": {
            "class": "py-3 px-3 fw-semibold text-uppercase small"
        }
    },
    "buildFooter": {
        "tagName": "td",
        "children": [
            {
                "tagName": "input",
                "attributes": {
                    "type": "text",
                    "placeholder": "enter ${columnName}",
                    "name": "${columnName}",
                    "class": "form-control"
                }
            }
        ]
    },
    "buildBodyCell": {
        "tagName": "td",
        "textContent": "${rowValue}",
        "attributes": {
            "class": "py-3 px-3 text-secondary"
        }
    },
    "buildHeaderRow": {
        "tagName": "tr",
        "attributes": {
            "class": "align-middle"
        },
        "children": []
    },
    "buildBody": {
        "tagName": "tr",
        "attributes": {
            "class": "align-middle"
        },
        "children": []
    },
    "buildBody1": {
        "outerTemplate": {
            "tagName": "tr",
            "attributes": {
                "class": "align-middle"
            }
        },
        "innerTemplate": {
            "tagName": "td",
            "textContent": "${rowValue}",
            "attributes": {
                "class": "py-3 px-3 text-secondary"
            }
        }
    }
}