{
    "buildColGroup": {
        "tagName": "col",
        "attributes": {
            "width": "${width}"
        }
    },
    "buildHeader": {
        "tagName": "th",
        "textContent": "${columnName}",
        "attributes": {
            "class": "py-3 px-3 fw-semibold text-uppercase small"
        }
    },
    "buildBody": {
        "outerTemplate": {
            "tagName": "tr",
            "attributes": {
                "class": "align-middle"
            }
        },
        "innerTemplate": {
            "tagName": "td",
            "textContent": "${rowValue}",
            "attributes": {
                "class": "py-3 px-3 text-secondary"
            }
        }
    }
}